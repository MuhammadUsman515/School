# ─── DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql://bizvinc:password@localhost:5432/bizvinc_school
REDIS_URL=redis://localhost:6379

# ─── AUTH ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI / LLM ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-02-01

# ─── COMMUNICATIONS ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_PROJECT_ID=bizvinc-school
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase@bizvinc-school.iam.gserviceaccount.com

# ─── PAYMENTS ─────────────────────────────────────────────
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key-here
PAYTABS_PROFILE_ID=your-paytabs-profile-id
PAYTABS_SERVER_KEY=your-paytabs-server-key

# ─── STORAGE ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=bizvinc-school-uploads

# ─── GOOGLE ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key

# ─── APP ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
AI_SERVICE_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
